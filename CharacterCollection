using System.Collections;
using System.Collections.Generic;
using System.Linq;

namespace ConsoleApp20;

public class CharacterCollection : IEnumerable<Personag>
{
  
    private List<Personag> _characters = new List<Personag>();


    public void Add(Personag character)
    {
        _characters.Add(character);
    }


    public IEnumerator<Personag> GetEnumerator()
    {
        for (int i = 0; i < _characters.Count; i++)
        {
            yield return _characters[i];
        }
    }

    public IEnumerable<Personag> GetHP()
    {
        for (int i = 0; i < _characters.Count; i++)
        {
            if (_characters[i].PercentOfHealth > 50)
            {
                yield return _characters[i];
            }
        }
    }
    
    IEnumerator IEnumerable.GetEnumerator()
    {
        return GetEnumerator();
    }
    
}
